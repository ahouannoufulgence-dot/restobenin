# Copiez ce fichier en .env.local (en local) et renseignez les mêmes variables dans Vercel
# (Project Settings > Environment Variables). Valeurs : tableau de bord Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# NE JAMAIS ajouter ici la clé service_role ni le mot de passe de la base dans un fichier du dépôt : ils donnent tous les droits.
#
# Paiement des abonnements (FedaPay). SERVEUR UNIQUEMENT : à saisir dans Vercel (Environment Variables), jamais dans le dépôt
# ni dans une conversation. Sans ces variables, le bouton Payer répond « Le paiement n'est pas encore activé ».
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxx      # clé secrète FedaPay (sk_live_… pour les vrais paiements)
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxxxxxx  # clé de signature des notifications (wh_live_… en mode réel)
FEDAPAY_ENV=sandbox                                 # « sandbox » (essais) ou « live » (vrais paiements)
SUPABASE_SERVICE_ROLE_KEY=                          # Supabase > Project Settings > API > service_role (secrète)
