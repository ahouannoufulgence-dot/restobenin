# Copiez ce fichier en .env.local (en local) et renseignez les mêmes variables dans Vercel
# (Project Settings > Environment Variables). Valeurs : tableau de bord Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# NE JAMAIS ajouter ici la clé service_role ni le mot de passe de la base : ils donnent tous les droits.
